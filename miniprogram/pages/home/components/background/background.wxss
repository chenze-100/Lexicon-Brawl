.bg {
  position: absolute;
  width: 750rpx;
  height: 1341rpx;
  left: 0;
  top: 0;
  z-index: -1;
  background:
    radial-gradient(circle at 84% 7%, rgba(255, 176, 32, 0.22) 0, rgba(255, 176, 32, 0) 26%),
    radial-gradient(circle at 10% 24%, rgba(255, 90, 60, 0.14) 0, rgba(255, 90, 60, 0) 30%),
    linear-gradient(180deg, #FFF1E6 0%, #FFE4D6 40%, #FFF9F5 72%, #FFFFFF 100%);
}

.bg::after {
  position: absolute;
  display: block;
  left: -10%;
  right: -10%;
  bottom: 0;
  height: 300rpx;
  background: radial-gradient(62% 100% at 50% 100%, rgba(255, 138, 91, 0.24) 0%, rgba(255, 138, 91, 0) 72%);
  content: '';
}

.home-sun {
  position: absolute;
  width: 124rpx;
  height: 124rpx;
  left: 594rpx;
  top: 190rpx;
}

.home-setting {
  position: absolute;
  width: 64rpx;
  height: 64rpx;
  left: 622rpx;
  top: 220rpx;
  padding: 16rpx;
  box-sizing: border-box;
  background: rgba(255, 90, 60, 0.92);
  border-radius: 50%;
  box-shadow: 0 8rpx 18rpx rgba(255, 90, 60, 0.28);
}
