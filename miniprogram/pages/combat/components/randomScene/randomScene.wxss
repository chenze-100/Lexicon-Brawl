.userinfo {
  margin: 0 auto;
  position: relative;
  width: 480rpx;
  height: 480rpx;
  margin-top: 10vh;
}

.userinfo-avatar {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  left: 180rpx;
  top: 180rpx;
}

@keyframes ring-rotate {
  from { transform: rotate(0); }
  to { transform: rotate(360deg); }
}

@keyframes ring-rotate-reverse {
  from { transform: rotate(0); }
  to { transform: rotate(-360deg); }
}

.circle-in {
  position: absolute;
  width: 287rpx;
  height: 287rpx;
  left: 96.5rpx;
  top: 96.5rpx;
  box-sizing: border-box;
  border: 6rpx solid rgba(255, 90, 60, 0.32);
  border-top-color: rgba(255, 176, 32, 0.9);
  border-radius: 50%;
  animation: ring-rotate 36s linear infinite;
}

.circle-out {
  position: absolute;
  width: 480rpx;
  height: 480rpx;
  left: 0;
  top: 0;
  box-sizing: border-box;
  border: 4rpx dashed rgba(255, 90, 60, 0.26);
  border-radius: 50%;
  animation: ring-rotate-reverse 36s linear infinite;
}

.matching {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.matching-title {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-top: 32rpx;
}

.matching-desc {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-secondary);
  margin-top: 16rpx;
}

.matching-button {
  width: 480rpx !important;
  height: 80rpx;
  background: linear-gradient(135deg, #FF8A5B 0%, #FF5A3C 100%);
  border-radius: 64rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 500;
  margin-top: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.matched {
  display: block;
  text-align: center;
  font-size: 64rpx;
  font-weight: 500;
  color: var(--brand-deep);
  margin-top: 32rpx;
}