page {
  position: relative;
  min-height: 100vh;
}

page::before,
page::after {
  display: block;
  content: "";
  position: fixed;
  top: 0;
  width: 50%;
  height: 100vh;
  z-index: -1;
}

page::before {
  background: linear-gradient(160deg, #FFF3EA 0%, #FFE2D3 100%);
  left: 0;
}

page::after {
  background: linear-gradient(200deg, #FFDDCC 0%, #FFC7AE 100%);
  right: 0;
}

.header {
  position: relative;
  display: flex;
  align-items: center;
  width: 750rpx;
}

.header-icon {
  width: 37rpx;
  height: 38rpx;
  margin-left: 48rpx;
  filter: hue-rotate(165deg) saturate(1.5) brightness(1.05);
}

.header-title {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-left: 24rpx;
}

.header-bgm-setting {
  height: 55rpx;
  width: 54rpx;
  position: absolute;
  top: 50%;
  transform: translateY(-27rpx);
  right: 108px;
}